{
  "name": "molforge-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MolForge Viewer — Rich content for Gemini Enterprise (3D structures, ADMET tables, candidate galleries)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.3.0",
    "express": "^5.2.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.0",
    "smiles-drawer": "^2.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.1",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "vite": "^8.3.0"
  },
  "overrides": {
    "shell-quote": ">=1.12.0"
  }
}
