{
  "name": "molforge-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MolForge Viewer — Rich content for Gemini Enterprise (3D structures, ADMET tables, candidate galleries)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^8.3.0",
    "express": "^4.22.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.0",
    "smiles-drawer": "^2.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.5",
    "postcss": "^8.5.29",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.4"
  },
  "overrides": {
    "shell-quote": ">=1.12.0"
  }
}
