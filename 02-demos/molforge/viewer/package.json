{
  "name": "molforge-viewer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "MolForge Viewer — Rich content for Gemini Enterprise (3D structures, ADMET tables, candidate galleries)",
  "scripts": {
    "dev": "concurrently -k -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node server.js",
    "dev:client": "vite",
    "build": "vite build",
    "start": "node server.js"
  },
  "dependencies": {
    "@google-cloud/storage": "^7.12.1",
    "express": "^4.21.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "react-router-dom": "^6.30.6",
    "remark-gfm": "^4.0.0",
    "smiles-drawer": "^2.1.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "postcss": "^8.4.41",
    "tailwindcss": "^3.4.10",
    "vite": "^5.4.2"
  }
}
