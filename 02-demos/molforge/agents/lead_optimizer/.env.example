# Template for agents/lead_optimizer/.env — copy, fill in, and keep local.
# setup.sh writes the real file for you (setup.sh::write_env); it is gitignored
# because it is a generated artifact of one specific deployment.

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# v2 topology:
#  - ESMFold: LOCAL on the RTX PRO 6000 Blackwell node (GKE, us-south1-b), public LB (MVP).
#  - GenMol + DiffDock: NVIDIA-HOSTED NIMs (genmol.py/diffdock.py default to
#    health.api.nvidia.com) — no URL override here.
#  - Nemotron SAR: Model Garden endpoint (set in sar_analysis.py).
MOLFORGE_ESMFOLD_URL=http://<esmfold-lb-ip>:8000
MOLFORGE_RDKIT_URL=
MOLFORGE_ARTIFACTS_BUCKET=your-artifacts-bucket
MOLFORGE_VIEWER_URL=

# The NVIDIA API key is NOT stored here. _nvidia.py fetches it at runtime from
# Secret Manager at projects/${GOOGLE_CLOUD_PROJECT}/secrets/molforge-nvidia-api-key,
# using the Agent Runtime service account (needs roles/secretmanager.secretAccessor).
# Override the full resource path with NVIDIA_API_KEY_SECRET, or set
# NVIDIA_API_KEY directly for local dev only.
