# Template for agents/orchestrator/.env — copy, fill in, and keep local.
# setup.sh writes the real file for you (setup.sh::write_env); it is gitignored
# because it is a generated artifact of one specific deployment.
#
# Every value below is deployment-specific. There are no safe defaults: the
# tools import-fail if GOOGLE_CLOUD_PROJECT is missing, which is deliberate —
# a wrong-but-plausible default sends traffic to somebody else's project.

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Sub-agent Agent Runtime IDs. These are minted fresh by EVERY `adk deploy` of
# the sub-agents — after redeploying lead_optimizer or admet_safety_agent you
# must paste the new numeric ID here and redeploy the orchestrator.
LEAD_OPTIMIZER_ENGINE_ID=
ADMET_SAFETY_ENGINE_ID=

# Cloud Run service URLs (from `gcloud run services describe <svc> --format='value(status.url)')`.
MOLFORGE_DATA_RETRIEVAL_URL=
MOLFORGE_VIEWER_URL=

# Optional: external A2A peer. Leave unset if you are not running PharmaPilot.
PHARMAPILOT_A2A_URL=
