# Template for agents/admet_safety_agent/.env — copy, fill in, and keep local.
# setup.sh writes the real file for you (setup.sh::write_env); it is gitignored
# because it is a generated artifact of one specific deployment.

GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# v2: ADMET-AI + RDKit on Cloud Run (CPU); Nemotron-Nano via Model Garden (report_gen.py).
MOLFORGE_ADMET_AI_URL=
MOLFORGE_RDKIT_URL=
MOLFORGE_ARTIFACTS_BUCKET=your-artifacts-bucket
MOLFORGE_VIEWER_URL=
